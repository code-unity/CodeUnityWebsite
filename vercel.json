{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "^/home-one$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/home-two$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/home-three$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/static/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/apps$",
      "dest": "/apps/index.html"
    },
    {
      "src": "^/about$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/service$",
      "dest": "/service/index.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/work$",
      "dest": "/work/index.html"
    },
    {
      "src": "^/blog-grid$",
      "dest": "/blog-grid/index.html"
    },
    {
      "src": "^/blog-classic$",
      "dest": "/blog-classic/index.html"
    },
    {
      "src": "^/apps/pocket-ai$",
      "dest": "/apps/pocket-ai/index.html"
    },
    {
      "src": "^/apps/llm-radar$",
      "dest": "/apps/llm-radar/index.html"
    },
    {
      "src": "^/apps/toolgenie$",
      "dest": "/apps/toolgenie/index.html"
    },
    {
      "src": "^/apps/white-noise$",
      "dest": "/apps/white-noise/index.html"
    },
    {
      "src": "^/apps/biology-ai$",
      "dest": "/apps/biology-ai/index.html"
    },
    {
      "src": "^/apps/sokoban$",
      "dest": "/apps/sokoban/index.html"
    },
    {
      "src": "^/apps/islam$",
      "dest": "/apps/islam/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/work-details/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/blog-details/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/tag/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/category/[^/]+$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
