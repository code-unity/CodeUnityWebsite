{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "build",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home-one",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-two",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home-three",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apps",
      "destination": "/apps/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/service",
      "destination": "/service/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/blog-grid",
      "destination": "/blog-grid/index.html"
    },
    {
      "source": "/blog-classic",
      "destination": "/blog-classic/index.html"
    },
    {
      "source": "/apps/pocket-ai",
      "destination": "/apps/pocket-ai/index.html"
    },
    {
      "source": "/apps/llm-radar",
      "destination": "/apps/llm-radar/index.html"
    },
    {
      "source": "/apps/toolgenie",
      "destination": "/apps/toolgenie/index.html"
    },
    {
      "source": "/apps/white-noise",
      "destination": "/apps/white-noise/index.html"
    },
    {
      "source": "/apps/biology-ai",
      "destination": "/apps/biology-ai/index.html"
    },
    {
      "source": "/apps/sokoban",
      "destination": "/apps/sokoban/index.html"
    },
    {
      "source": "/apps/islam",
      "destination": "/apps/islam/index.html"
    },
    {
      "source": "/work-details/:id",
      "destination": "/index.html"
    },
    {
      "source": "/blog-details/:id",
      "destination": "/index.html"
    },
    {
      "source": "/tag/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/category/:slug",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
